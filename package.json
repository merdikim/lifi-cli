{
  "name": "@lifi/cli",
  "version": "0.1.1-alpha.1",
  "description": "CLI for the LI.FI cross-chain bridge & DEX aggregation API",
  "homepage": "https://github.com/lifinance/lifi-cli",
  "bugs": {
    "url": "https://github.com/lifinance/lifi-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifinance/lifi-cli.git"
  },
  "license": "MIT",
  "author": "LI.FI <github@li.finance>",
  "keywords": [
    "lifi",
    "lifinance",
    "cli",
    "bridge",
    "dex",
    "cross-chain",
    "aggregator",
    "swap"
  ],
  "type": "module",
  "bin": {
    "lifi": "./dist/lifi.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/lifi.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "release": "commit-and-tag-version -a -s",
    "release:alpha": "commit-and-tag-version -a -s --prerelease alpha",
    "release:beta": "commit-and-tag-version -a -s --prerelease beta"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "axios": "^1.7.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ethers": "^6.16.0",
    "ora": "^8.1.0",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.48.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/node": "^22.0.0",
    "commit-and-tag-version": "^12.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsdown": "^0.21.8",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
